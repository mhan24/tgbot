SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
# 必填：机器人 token、默认群与验证频道的数字 ID
TELEGRAM_BOT_TOKEN=
GROUP_ID=-1003014905211
CHANNEL_ID=-1000000000002
# 验证卡片“关注频道”按钮使用的链接：可填 @频道用户名 或 t.me 链接
TELEGRAM_GROUP=@setupode
TELEGRAM_CHANNEL=@setup0de
# 验证有效期（秒），取值 30–300
VERIFY_SECONDS=240
DB_PATH=bot.sqlite3
# 可选：cardbincheck.com（IPNOVA）的 BIN 查询密钥；留空时按上游免费 IP 限流访问
BIN_API_KEY=
# AI 问答：OpenAI 兼容网关；AI_API_KEY 留空时 /ai 提示未配置
AI_API_BASE=https://api.setup0.de/v1
AI_API_KEY=
AI_MODEL=bailu-2.8
AI_TIMEOUT=60
# 联网搜索（Exa）；留空时 /ai 只用自己的知识回答，不联网
EXA_API_KEY=
# 是否联网的判定（TypeSafe / Jev Noul）；留空时 /ai 默认联网搜索
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# 可选：思考中的贴纸 file_id 或图片 URL；留空时用 🤔 表情回应提问
AI_THINKING_STICKER=
