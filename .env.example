SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
# 必填：机器人 token、默认群与验证频道的数字 ID
TELEGRAM_BOT_TOKEN=
GROUP_ID=-1003014905211
CHANNEL_ID=-1000000000002
# 验证卡片“关注频道”按钮使用的链接：可填 @频道用户名 或 t.me 链接
TELEGRAM_GROUP=@setupode
TELEGRAM_CHANNEL=@setup0de
# 验证有效期（秒），取值 30–300
VERIFY_SECONDS=240
# 群内机器人消息（含其他 bot）自动删除的秒数，设为 0 关闭
DELETE_AFTER_SECONDS=30
DB_PATH=bot.sqlite3
