SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP=@setupode
TELEGRAM_CHANNEL=@setup0de
GROUP_ID=-1003014905211
CHANNEL_ID=-1002974148099
MUTE_SECONDS=86400
VERIFY_SECONDS=240
# 群内机器人消息（含其他 bot）自动删除的秒数，设为 0 关闭
DELETE_AFTER_SECONDS=30
# 普通成员每天在群内可执行的机器人操作次数，超出后需私聊
GROUP_COMMAND_LIMIT=3
# 群主可用 /settings 为每个群分别覆盖以下运行参数
CHECKIN_MIN=1
CHECKIN_MAX=5
MESSAGE_POINTS=1
MESSAGE_DAILY_LIMIT=5
AI_COOLDOWN_SECONDS=60
# 供 AI 参考的群聊记录：保留条数上限 / 每次带给模型的最大条数
HISTORY_MESSAGES=50
HISTORY_CONTEXT=50
# /report 手动提交 Jev 广告举报，模型判为广告后需群内投票确认
JEV_ENABLED=1
JEV_MODEL=jev-latest
JEV_API_KEY=
# 累计积分达到该值时把成员标签改为 UPGRADE_TAG；已有自定义标签不覆盖
UPGRADE_POINTS=50
UPGRADE_TAG=家人
DB_PATH=bot.sqlite3
AI_BASE_URL=https://api.setup0.de/v1
AI_API_KEY=
AI_MODEL=grok-4.7
