SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP=@setupode
TELEGRAM_CHANNEL=@setup0de
GROUP_ID=-1003014905211
CHANNEL_ID=-1000000000002
MUTE_SECONDS=86400
VERIFY_SECONDS=240
# 群内机器人消息（含其他 bot）自动删除的秒数，设为 0 关闭
DELETE_AFTER_SECONDS=30
# 群主可用 /settings 覆盖本群的以下运行参数
MESSAGE_POINTS=1
MESSAGE_DAILY_LIMIT=5
# /report 手动提交 Jev 广告举报，模型判为广告后需群内投票确认
JEV_ENABLED=1
JEV_MODEL=jev-latest
JEV_API_KEY=
# 累计积分达到该值时把成员标签改为 UPGRADE_TAG；已有自定义标签不覆盖
UPGRADE_POINTS=50
UPGRADE_TAG=家人
DB_PATH=bot.sqlite3
